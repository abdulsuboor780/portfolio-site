<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#030712"/>
      <stop offset="50%" stop-color="#0f172a"/>
      <stop offset="100%" stop-color="#022c22"/>
    </linearGradient>
    <linearGradient id="cardGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e293b"/>
      <stop offset="100%" stop-color="#0f172a"/>
    </linearGradient>
    <linearGradient id="accentGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#10b981"/>
      <stop offset="50%" stop-color="#14b8a6"/>
      <stop offset="100%" stop-color="#06b6d4"/>
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="12" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>

  <!-- Background -->
  <rect width="1200" height="675" fill="url(#bgGrad)"/>
  
  <!-- Subtle Grid lines -->
  <g stroke="#334155" stroke-width="1" opacity="0.15">
    <line x1="0" y1="135" x2="1200" y2="135"/>
    <line x1="0" y1="270" x2="1200" y2="270"/>
    <line x1="0" y1="405" x2="1200" y2="405"/>
    <line x1="0" y1="540" x2="1200" y2="540"/>
    <line x1="240" y1="0" x2="240" y2="675"/>
    <line x1="480" y1="0" x2="480" y2="675"/>
    <line x1="720" y1="0" x2="720" y2="675"/>
    <line x1="960" y1="0" x2="960" y2="675"/>
  </g>

  <!-- Glow orb -->
  <circle cx="950" cy="200" r="180" fill="#10b981" opacity="0.12" filter="url(#glow)"/>

  <!-- Left: Header & Branding -->
  <g transform="translate(70, 75)">
    <!-- Badge -->
    <rect width="250" height="34" rx="17" fill="#064e3b" stroke="#059669" stroke-width="1.5"/>
    <circle cx="20" cy="17" r="5" fill="#34d399"/>
    <text x="36" y="22" fill="#a7f3d0" font-family="system-ui, -apple-system, sans-serif" font-size="12" font-weight="700" letter-spacing="1">LOCAL SEO BLUEPRINT</text>

    <!-- Main Title -->
    <text x="0" y="85" fill="#ffffff" font-family="system-ui, -apple-system, sans-serif" font-size="40" font-weight="900" letter-spacing="-0.5">Google Map 3-Pack</text>
    <text x="0" y="135" fill="url(#accentGrad)" font-family="system-ui, -apple-system, sans-serif" font-size="40" font-weight="900">Rank #1 Domination</text>

    <!-- Subtitle bullet points -->
    <g transform="translate(0, 185)" font-family="system-ui, -apple-system, sans-serif" font-size="14.5" fill="#94a3b8">
      <circle cx="8" cy="8" r="4" fill="#10b981"/>
      <text x="24" y="13">Primary Category &amp; Geo-Grid Proximity</text>
      
      <circle cx="8" cy="38" r="4" fill="#10b981"/>
      <text x="24" y="43">Hyper-Local Citations &amp; NAP Consistency</text>
      
      <circle cx="8" cy="68" r="4" fill="#10b981"/>
      <text x="24" y="73">Keyword-Enriched Review Velocity</text>
    </g>
    
    <!-- Strategy Metric Box -->
    <g transform="translate(0, 310)">
      <rect width="450" height="95" rx="16" fill="#0f172a" stroke="#1e293b" stroke-width="1.5"/>
      <g transform="translate(25, 25)">
        <text x="0" y="24" fill="#34d399" font-family="system-ui, -apple-system, sans-serif" font-size="28" font-weight="800">+340%</text>
        <text x="0" y="45" fill="#64748b" font-family="system-ui, -apple-system, sans-serif" font-size="12" font-weight="600">INBOUND CALLS</text>
      </g>
      <line x1="160" y1="20" x2="160" y2="70" stroke="#334155" stroke-width="1"/>
      <g transform="translate(185, 25)">
        <text x="0" y="24" fill="#38bdf8" font-family="system-ui, -apple-system, sans-serif" font-size="28" font-weight="800">#1 Top 3</text>
        <text x="0" y="45" fill="#64748b" font-family="system-ui, -apple-system, sans-serif" font-size="12" font-weight="600">MAP PACK POSITION</text>
      </g>
      <line x1="310" y1="20" x2="310" y2="70" stroke="#334155" stroke-width="1"/>
      <g transform="translate(335, 25)">
        <text x="0" y="24" fill="#a78bfa" font-family="system-ui, -apple-system, sans-serif" font-size="28" font-weight="800">100%</text>
        <text x="0" y="45" fill="#64748b" font-family="system-ui, -apple-system, sans-serif" font-size="12" font-weight="600">ORGANIC REACH</text>
      </g>
    </g>
  </g>

  <!-- Right: Visual Map 3-Pack & GeoGrid Simulation Card -->
  <g transform="translate(615, 65)">
    <!-- Main Map Container -->
    <rect width="515" height="545" rx="24" fill="url(#cardGrad)" stroke="#334155" stroke-width="2" filter="url(#glow)"/>
    
    <!-- Window Bar -->
    <rect width="515" height="46" rx="24" fill="#0f172a"/>
    <rect y="22" width="515" height="24" fill="#0f172a"/>
    <circle cx="28" cy="23" r="5" fill="#ef4444"/>
    <circle cx="46" cy="23" r="5" fill="#f59e0b"/>
    <circle cx="64" cy="23" r="5" fill="#10b981"/>
    <text x="85" y="27" fill="#94a3b8" font-family="system-ui, -apple-system, sans-serif" font-size="11.5" font-mono="true">google.com/maps/search?q=plumber+near+me</text>

    <!-- Map Search Top Card: Rank #1 (Highlighted) -->
    <g transform="translate(20, 65)">
      <rect width="475" height="98" rx="14" fill="#064e3b" stroke="#10b981" stroke-width="2"/>
      <!-- Pin Badge -->
      <rect x="18" y="20" width="28" height="28" rx="8" fill="#10b981"/>
      <text x="32" y="39" fill="#022c22" font-family="system-ui, -apple-system, sans-serif" font-size="16" font-weight="900" text-anchor="middle">A</text>
      
      <text x="58" y="32" fill="#ffffff" font-family="system-ui, -apple-system, sans-serif" font-size="15" font-weight="800">Apex Plumbing Pros (Verified #1)</text>
      <text x="58" y="52" fill="#34d399" font-family="system-ui, -apple-system, sans-serif" font-size="12.5">5.0 ★★★★★ (184 reviews) · Plumber</text>
      <text x="58" y="72" fill="#94a3b8" font-family="system-ui, -apple-system, sans-serif" font-size="11.5">Open 24/7 · Highly Rated Local Proximity</text>
      
      <!-- Call Button -->
      <rect x="385" y="28" width="70" height="32" rx="8" fill="#10b981"/>
      <text x="420" y="49" fill="#022c22" font-family="system-ui, -apple-system, sans-serif" font-size="11.5" font-weight="800" text-anchor="middle">CALL</text>
    </g>

    <!-- Map Search Rank #2 -->
    <g transform="translate(20, 175)">
      <rect width="475" height="85" rx="14" fill="#1e293b" stroke="#334155" stroke-width="1"/>
      <rect x="18" y="16" width="26" height="26" rx="6" fill="#475569"/>
      <text x="31" y="34" fill="#ffffff" font-family="system-ui, -apple-system, sans-serif" font-size="14" font-weight="800" text-anchor="middle">B</text>
      <text x="56" y="30" fill="#cbd5e1" font-family="system-ui, -apple-system, sans-serif" font-size="13.5" font-weight="700">Competitor Service Corp</text>
      <text x="56" y="48" fill="#94a3b8" font-family="system-ui, -apple-system, sans-serif" font-size="12">4.4 ★★★★☆ (62 reviews)</text>
      <text x="56" y="66" fill="#64748b" font-family="system-ui, -apple-system, sans-serif" font-size="11">Closes 6 PM · 2.4 miles away</text>
    </g>

    <!-- Map Search Rank #3 -->
    <g transform="translate(20, 272)">
      <rect width="475" height="85" rx="14" fill="#1e293b" stroke="#334155" stroke-width="1"/>
      <rect x="18" y="16" width="26" height="26" rx="6" fill="#475569"/>
      <text x="31" y="34" fill="#ffffff" font-family="system-ui, -apple-system, sans-serif" font-size="14" font-weight="800" text-anchor="middle">C</text>
      <text x="56" y="30" fill="#cbd5e1" font-family="system-ui, -apple-system, sans-serif" font-size="13.5" font-weight="700">Metro Emergency Rooter</text>
      <text x="56" y="48" fill="#94a3b8" font-family="system-ui, -apple-system, sans-serif" font-size="12">4.2 ★★★★☆ (41 reviews)</text>
      <text x="56" y="66" fill="#64748b" font-family="system-ui, -apple-system, sans-serif" font-size="11">Open · 4.8 miles away</text>
    </g>

    <!-- Geo-Grid Live Pins Visualization -->
    <g transform="translate(20, 370)">
      <rect width="475" height="150" rx="14" fill="#090d16" stroke="#1e293b" stroke-width="1"/>
      <text x="18" y="24" fill="#94a3b8" font-family="system-ui, -apple-system, sans-serif" font-size="11" font-weight="700" letter-spacing="0.5">GEO-GRID PROXIMITY RADIUS (GREEN = #1 POSITION)</text>
      
      <!-- 7 Grid Pins -->
      <g transform="translate(25, 45)">
        <circle cx="20" cy="20" r="15" fill="#10b981"/>
        <text x="20" y="25" fill="#022c22" font-family="sans-serif" font-size="12" font-weight="900" text-anchor="middle">1</text>
        
        <circle cx="85" cy="20" r="15" fill="#10b981"/>
        <text x="85" y="25" fill="#022c22" font-family="sans-serif" font-size="12" font-weight="900" text-anchor="middle">1</text>
        
        <circle cx="150" cy="20" r="15" fill="#10b981"/>
        <text x="150" y="25" fill="#022c22" font-family="sans-serif" font-size="12" font-weight="900" text-anchor="middle">1</text>
        
        <circle cx="215" cy="20" r="15" fill="#10b981"/>
        <text x="215" y="25" fill="#022c22" font-family="sans-serif" font-size="12" font-weight="900" text-anchor="middle">1</text>
        
        <circle cx="280" cy="20" r="15" fill="#10b981"/>
        <text x="280" y="25" fill="#022c22" font-family="sans-serif" font-size="12" font-weight="900" text-anchor="middle">1</text>
        
        <circle cx="345" cy="20" r="15" fill="#10b981"/>
        <text x="345" y="25" fill="#022c22" font-family="sans-serif" font-size="12" font-weight="900" text-anchor="middle">1</text>
        
        <circle cx="410" cy="20" r="15" fill="#34d399"/>
        <text x="410" y="25" fill="#022c22" font-family="sans-serif" font-size="12" font-weight="900" text-anchor="middle">2</text>
      </g>
    </g>
  </g>
</svg>
